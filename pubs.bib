@article{nowlinAdvocacyCoalitionsPolitical2022,
  title = {Advocacy {{Coalitions}} and {{Political Control}}},
  author = {Nowlin, Matthew C. and Trochmann, Maren and Rabovsky, Thomas M.},
  date = {2022},
  journaltitle = {Politics \& Policy},
